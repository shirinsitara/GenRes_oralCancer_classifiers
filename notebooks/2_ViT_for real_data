{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"gpuType":"T4","authorship_tag":"ABX9TyOdXPhjhsB+emnC7IdomQ/y"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"},"accelerator":"GPU"},"cells":[{"cell_type":"code","source":["# =========================================================\n","# 1. Install packages\n","# =========================================================\n","# !pip install timm scikit-learn umap-learn matplotlib seaborn -q\n","\n","# =========================================================\n","# 2. Mount Google Drive\n","# =========================================================\n","from google.colab import drive\n","drive.mount('/content/drive')\n","\n","# =========================================================\n","# 3. Imports\n","# =========================================================\n","import os\n","import json\n","import shutil\n","from pathlib import Path\n","\n","import numpy as np\n","import pandas as pd\n","import torch\n","import torch.nn as nn\n","from torch.utils.data import Dataset, DataLoader\n","from torchvision import transforms\n","from torchvision.models import vit_b_16, ViT_B_16_Weights\n","from PIL import Image\n","from sklearn.metrics import (\n","    classification_report,\n","    confusion_matrix,\n","    roc_auc_score,\n","    average_precision_score,\n","    cohen_kappa_score,\n",")\n","from sklearn.preprocessing import label_binarize\n","import matplotlib.pyplot as plt\n","\n","# =========================================================\n","# 4. Device\n","# =========================================================\n","device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n","print(\"Device:\", device)\n","\n","# =========================================================\n","# 5. Copy patches from Drive to local Colab disk (faster I/O)\n","# =========================================================\n","drive_patch_root = \"/content/drive/MyDrive/GenResData/Patches\"\n","local_patch_root = \"/content/patches\"\n","\n","shutil.copytree(drive_patch_root, local_patch_root, dirs_exist_ok=True)\n","print(\"Patches copied from Drive to local Colab.\")\n","\n","for split in [\"train\", \"val\", \"test\"]:\n","    split_dir = Path(local_patch_root) / split\n","    print(\"\\n\", split, \"exists:\", split_dir.exists())\n","    if split_dir.exists():\n","        for class_dir in split_dir.iterdir():\n","            if class_dir.is_dir():\n","                n_images = len(list(class_dir.glob(\"*\")))\n","                print(class_dir.name, \":\", n_images)\n","\n","# =========================================================\n","# 6. CSV paths (defined BEFORE anything uses them)\n","# =========================================================\n","train_csv = \"/content/drive/MyDrive/GenResData/train_patch_df.csv\"\n","val_csv   = \"/content/drive/MyDrive/GenResData/val_patch_df.csv\"\n","test_csv  = \"/content/drive/MyDrive/GenResData/test_patch_df.csv\"\n","\n","# =========================================================\n","# 7. Clean test CSV of any rows pointing to missing files\n","# =========================================================\n","test_df = pd.read_csv(test_csv)\n","print(\"Original test size:\", len(test_df))\n","\n","test_df = test_df[test_df[\"patch_path\"].apply(os.path.exists)].reset_index(drop=True)\n","print(\"After removing missing files:\", len(test_df))\n","\n","clean_test_csv = \"/content/drive/MyDrive/GenResData/test_patch_df_clean.csv\"\n","test_df.to_csv(clean_test_csv, index=False)\n","\n","# =========================================================\n","# 8. Dataset class\n","#    Always returns 4 values: image, label, path, idx\n","# =========================================================\n","class OralPatchDataset(Dataset):\n","    def __init__(self, csv_file, transform=None):\n","        self.df = pd.read_csv(csv_file).reset_index(drop=True)\n","        self.transform = transform\n","\n","    def __len__(self):\n","        return len(self.df)\n","\n","    def __getitem__(self, idx):\n","        row = self.df.iloc[idx]\n","        img_path = str(row[\"patch_path\"])\n","        label = int(row[\"label\"])\n","\n","        image = Image.open(img_path).convert(\"RGB\")\n","        if self.transform is not None:\n","            image = self.transform(image)\n","\n","        return image, label, img_path, idx\n","\n","# =========================================================\n","# 9. Transforms\n","# =========================================================\n","train_tfms = transforms.Compose([\n","    transforms.Resize((224, 224)),\n","    transforms.RandomHorizontalFlip(),\n","    transforms.RandomRotation(10),\n","    transforms.ColorJitter(brightness=0.1, contrast=0.1, saturation=0.1),\n","    transforms.ToTensor(),\n","    transforms.Normalize(mean=[0.485, 0.456, 0.406],\n","                         std=[0.229, 0.224, 0.225])\n","])\n","\n","eval_tfms = transforms.Compose([\n","    transforms.Resize((224, 224)),\n","    transforms.ToTensor(),\n","    transforms.Normalize(mean=[0.485, 0.456, 0.406],\n","                         std=[0.229, 0.224, 0.225])\n","])\n","\n","# =========================================================\n","# 10. Datasets & Dataloaders\n","# =========================================================\n","train_ds = OralPatchDataset(train_csv, transform=train_tfms)\n","val_ds   = OralPatchDataset(val_csv, transform=eval_tfms)\n","test_ds  = OralPatchDataset(clean_test_csv, transform=eval_tfms)\n","\n","train_loader = DataLoader(train_ds, batch_size=16, shuffle=True, num_workers=2)\n","val_loader   = DataLoader(val_ds, batch_size=16, shuffle=False, num_workers=2)\n","test_loader  = DataLoader(test_ds, batch_size=16, shuffle=False, num_workers=2)\n","\n","print(len(train_ds), len(val_ds), len(test_ds))\n","\n","# =========================================================\n","# 11. (Optional) class weights -- kept here, disabled by default\n","#     since classes are \"fairly balanced\" per your notes.\n","#     Flip USE_CLASS_WEIGHTS to True to try it as an experiment.\n","# =========================================================\n","USE_CLASS_WEIGHTS = False\n","\n","if USE_CLASS_WEIGHTS:\n","    from sklearn.utils.class_weight import compute_class_weight\n","    train_df = pd.read_csv(train_csv)\n","    y_train = train_df[\"label\"].values\n","    class_weights = compute_class_weight(\n","        class_weight=\"balanced\",\n","        classes=np.unique(y_train),\n","        y=y_train\n","    )\n","    class_weights = torch.tensor(class_weights, dtype=torch.float).to(device)\n","    print(\"Class weights:\", class_weights)\n","else:\n","    class_weights = None\n","\n","# =========================================================\n","# 12. Model\n","# =========================================================\n","weights = ViT_B_16_Weights.DEFAULT\n","model = vit_b_16(weights=weights)\n","\n","num_classes = len(sorted(pd.read_csv(train_csv)[\"label\"].unique()))\n","print(\"Number of classes:\", num_classes)\n","\n","in_features = model.heads.head.in_features\n","model.heads.head = nn.Linear(in_features, num_classes)\n","model = model.to(device)\n","\n","# ---------------------------------------------------------\n","# PARTIAL FREEZING\n","# ViT-B/16 has 12 stacked encoder blocks (model.encoder.layers).\n","# We freeze the early blocks (general, already-good features from\n","# ImageNet pretraining) and only let the later blocks + the new\n","# classification head keep learning on our (small, ~1900-image)\n","# dataset. This drastically cuts down on overfitting compared to\n","# fine-tuning all 86M parameters.\n","#\n","# FREEZE_UP_TO_BLOCK = 8 means: blocks 0-7 are frozen (locked),\n","# blocks 8-11 (the last 4) + the head are trainable.\n","# Try 6 or 10 as alternatives if you want to fine-tune more/less.\n","# ---------------------------------------------------------\n","FREEZE_UP_TO_BLOCK = 8\n","\n","encoder_blocks = list(model.encoder.layers.children())\n","num_blocks = len(encoder_blocks)\n","print(f\"ViT has {num_blocks} encoder blocks. \"\n","      f\"Freezing blocks 0-{FREEZE_UP_TO_BLOCK - 1}, \"\n","      f\"fine-tuning blocks {FREEZE_UP_TO_BLOCK}-{num_blocks - 1} + head.\")\n","\n","# Step 1: freeze everything by default\n","for param in model.parameters():\n","    param.requires_grad = False\n","\n","# Step 2: unfreeze the later encoder blocks\n","for block in encoder_blocks[FREEZE_UP_TO_BLOCK:]:\n","    for param in block.parameters():\n","        param.requires_grad = True\n","\n","# Step 3: unfreeze the final encoder layer norm (feeds straight into the head)\n","for param in model.encoder.ln.parameters():\n","    param.requires_grad = True\n","\n","# Step 4: always unfreeze the new classification head (it's untrained, must learn)\n","for param in model.heads.head.parameters():\n","    param.requires_grad = True\n","\n","trainable_params = sum(p.numel() for p in model.parameters() if p.requires_grad)\n","total_params = sum(p.numel() for p in model.parameters())\n","print(f\"Trainable params: {trainable_params:,} / {total_params:,} \"\n","      f\"({100 * trainable_params / total_params:.1f}%)\")\n","\n","# ---------------------------------------------------------\n","# LABEL SMOOTHING\n","# Instead of training the model to be 100% confident in the\n","# correct label, we ask for e.g. 90% confidence, spreading the\n","# remaining 10% across the other classes. This discourages\n","# overconfidence, which is one symptom of overfitting.\n","# ---------------------------------------------------------\n","LABEL_SMOOTHING = 0.1\n","\n","criterion = nn.CrossEntropyLoss(weight=class_weights, label_smoothing=LABEL_SMOOTHING)\n","\n","# Only pass trainable (unfrozen) parameters to the optimizer\n","optimizer = torch.optim.AdamW(\n","    filter(lambda p: p.requires_grad, model.parameters()),\n","    lr=3e-5,\n","    weight_decay=1e-4,\n",")\n","\n","# =========================================================\n","# 13. Train / eval loops (both use the 4-value unpacking)\n","# =========================================================\n","def train_one_epoch(model, loader):\n","    model.train()\n","    running_loss = 0.0\n","    correct = 0\n","    total = 0\n","\n","    for images, labels, paths, indices in loader:\n","        images = images.to(device)\n","        labels = labels.to(device)\n","\n","        optimizer.zero_grad()\n","        outputs = model(images)\n","        loss = criterion(outputs, labels)\n","        loss.backward()\n","        optimizer.step()\n","\n","        running_loss += loss.item() * images.size(0)\n","        preds = outputs.argmax(dim=1)\n","        correct += (preds == labels).sum().item()\n","        total += labels.size(0)\n","\n","    return running_loss / total, correct / total\n","\n","\n","@torch.no_grad()\n","def evaluate(model, loader, return_probs=False):\n","    \"\"\"\n","    Runs the model on `loader` and returns loss + accuracy.\n","    If return_probs=True, also returns the raw labels and softmax\n","    probabilities (needed to compute AUROC/AUPRC).\n","    \"\"\"\n","    model.eval()\n","    running_loss = 0.0\n","    correct = 0\n","    total = 0\n","\n","    all_labels_ = []\n","    all_probs_ = []\n","\n","    for images, labels, paths, indices in loader:\n","        images = images.to(device)\n","        labels = labels.to(device)\n","\n","        outputs = model(images)\n","        loss = criterion(outputs, labels)\n","\n","        running_loss += loss.item() * images.size(0)\n","        probs = torch.softmax(outputs, dim=1)\n","        preds = probs.argmax(dim=1)\n","        correct += (preds == labels).sum().item()\n","        total += labels.size(0)\n","\n","        if return_probs:\n","            all_labels_.extend(labels.cpu().numpy())\n","            all_probs_.append(probs.cpu().numpy())\n","\n","    avg_loss = running_loss / total\n","    avg_acc = correct / total\n","\n","    if return_probs:\n","        return avg_loss, avg_acc, np.array(all_labels_), np.vstack(all_probs_)\n","    return avg_loss, avg_acc\n","\n","\n","def macro_auroc_auprc(y_true, y_prob, n_classes):\n","    \"\"\"\n","    Computes one-vs-rest AUROC and AUPRC per class, then averages them\n","    (\"macro\" average = each class counts equally).\n","    AUROC: how well the model ranks true-class images as more\n","           confident than not-that-class images (0.5 = random, 1.0 = perfect).\n","    AUPRC: similar idea, but more sensitive to class imbalance --\n","           standard to report alongside AUROC in medical imaging papers.\n","    \"\"\"\n","    y_bin = label_binarize(y_true, classes=list(range(n_classes)))\n","    aurocs, auprcs = [], []\n","    for c in range(n_classes):\n","        if y_bin[:, c].sum() == 0 or y_bin[:, c].sum() == len(y_bin):\n","            continue  # skip a class if it's missing entirely from this batch\n","        aurocs.append(roc_auc_score(y_bin[:, c], y_prob[:, c]))\n","        auprcs.append(average_precision_score(y_bin[:, c], y_prob[:, c]))\n","    return float(np.mean(aurocs)), float(np.mean(auprcs))\n","\n","# =========================================================\n","# 14. Training (with early stopping + per-epoch AUROC/AUPRC/kappa)\n","# =========================================================\n","results_dir = \"/content/drive/MyDrive/GenResData/ViT_results\"\n","os.makedirs(results_dir, exist_ok=True)\n","\n","history = {\n","    \"epoch\": [], \"train_loss\": [], \"train_acc\": [],\n","    \"val_loss\": [], \"val_acc\": [],\n","    \"val_macro_auroc\": [], \"val_macro_auprc\": [], \"val_kappa\": [],\n","}\n","\n","best_val_acc = 0\n","\n","# ---------------------------------------------------------\n","# EARLY STOPPING\n","# We watch val_loss (not val_acc) because val_loss creeping up while\n","# train_loss keeps dropping is the clearest sign of overfitting.\n","# PATIENCE = how many epochs in a row we tolerate no improvement\n","# before we stop training early.\n","# ---------------------------------------------------------\n","num_epochs = 30          # upper limit -- early stopping will likely end training sooner\n","PATIENCE = 3\n","best_val_loss = float(\"inf\")\n","epochs_no_improve = 0\n","\n","for epoch in range(num_epochs):\n","    train_loss, train_acc = train_one_epoch(model, train_loader)\n","    val_loss, val_acc, val_labels, val_probs = evaluate(model, val_loader, return_probs=True)\n","\n","    val_preds = val_probs.argmax(axis=1)\n","    val_macro_auroc, val_macro_auprc = macro_auroc_auprc(val_labels, val_probs, num_classes)\n","    val_kappa = cohen_kappa_score(val_labels, val_preds)\n","\n","    history[\"epoch\"].append(epoch + 1)\n","    history[\"train_loss\"].append(train_loss)\n","    history[\"train_acc\"].append(train_acc)\n","    history[\"val_loss\"].append(val_loss)\n","    history[\"val_acc\"].append(val_acc)\n","    history[\"val_macro_auroc\"].append(val_macro_auroc)\n","    history[\"val_macro_auprc\"].append(val_macro_auprc)\n","    history[\"val_kappa\"].append(val_kappa)\n","\n","    print(f\"Epoch {epoch+1}/{num_epochs}\")\n","    print(f\"Train loss: {train_loss:.4f} | Train acc: {train_acc:.4f}\")\n","    print(f\"Val loss:   {val_loss:.4f} | Val acc:   {val_acc:.4f} | \"\n","          f\"Val AUROC: {val_macro_auroc:.4f} | Val AUPRC: {val_macro_auprc:.4f} | \"\n","          f\"Val Kappa: {val_kappa:.4f}\")\n","\n","    # Save the best model by validation accuracy (what we deploy/report)\n","    if val_acc > best_val_acc:\n","        best_val_acc = val_acc\n","        torch.save(model.state_dict(), f\"{results_dir}/best_vit_oral_dysplasia.pth\")\n","        print(\"Saved best model\")\n","\n","    # Early stopping check, based on validation loss\n","    if val_loss < best_val_loss - 1e-4:\n","        best_val_loss = val_loss\n","        epochs_no_improve = 0\n","    else:\n","        epochs_no_improve += 1\n","        print(f\"No val_loss improvement for {epochs_no_improve} epoch(s).\")\n","        if epochs_no_improve >= PATIENCE:\n","            print(f\"Early stopping triggered after epoch {epoch + 1} \"\n","                  f\"(no val_loss improvement for {PATIENCE} epochs).\")\n","            break\n","\n","history_df = pd.DataFrame(history)\n","history_df.to_csv(f\"{results_dir}/training_history.csv\", index=False)\n","print(\"Saved training history.\")\n","\n","# =========================================================\n","# 15. Plots\n","# =========================================================\n","plt.figure(figsize=(8, 5))\n","plt.plot(history_df[\"epoch\"], history_df[\"train_loss\"], marker=\"o\", label=\"Train Loss\")\n","plt.plot(history_df[\"epoch\"], history_df[\"val_loss\"], marker=\"o\", label=\"Val Loss\")\n","plt.xlabel(\"Epoch\"); plt.ylabel(\"Loss\")\n","plt.title(\"ViT Training and Validation Loss\")\n","plt.legend(); plt.grid(True)\n","plt.savefig(f\"{results_dir}/loss_curve.png\", dpi=300, bbox_inches=\"tight\")\n","plt.show()\n","\n","plt.figure(figsize=(8, 5))\n","plt.plot(history_df[\"epoch\"], history_df[\"train_acc\"], marker=\"o\", label=\"Train Accuracy\")\n","plt.plot(history_df[\"epoch\"], history_df[\"val_acc\"], marker=\"o\", label=\"Val Accuracy\")\n","plt.xlabel(\"Epoch\"); plt.ylabel(\"Accuracy\")\n","plt.title(\"ViT Training and Validation Accuracy\")\n","plt.legend(); plt.grid(True)\n","plt.savefig(f\"{results_dir}/accuracy_curve.png\", dpi=300, bbox_inches=\"tight\")\n","plt.show()\n","\n","plt.figure(figsize=(8, 5))\n","plt.plot(history_df[\"epoch\"], history_df[\"val_macro_auroc\"], marker=\"o\", label=\"Val Macro AUROC\")\n","plt.plot(history_df[\"epoch\"], history_df[\"val_macro_auprc\"], marker=\"o\", label=\"Val Macro AUPRC\")\n","plt.plot(history_df[\"epoch\"], history_df[\"val_kappa\"], marker=\"o\", label=\"Val Cohen's Kappa\")\n","plt.xlabel(\"Epoch\"); plt.ylabel(\"Score\")\n","plt.title(\"ViT Validation AUROC / AUPRC / Kappa Across Training\")\n","plt.legend(); plt.grid(True)\n","plt.savefig(f\"{results_dir}/val_ranking_metrics_curve.png\", dpi=300, bbox_inches=\"tight\")\n","plt.show()\n","\n","# =========================================================\n","# 16. Test evaluation (single clean block -- no duplicates)\n","# =========================================================\n","model.load_state_dict(\n","    torch.load(f\"{results_dir}/best_vit_oral_dysplasia.pth\", map_location=device)\n",")\n","model.eval()\n","\n","all_preds = []\n","all_labels = []\n","all_paths = []\n","all_indices = []\n","all_probabilities = []\n","\n","with torch.no_grad():\n","    for images, labels, paths, indices in test_loader:\n","        images = images.to(device)\n","\n","        outputs = model(images)\n","        probabilities = torch.softmax(outputs, dim=1)\n","        preds = outputs.argmax(dim=1)\n","\n","        all_preds.extend(preds.cpu().numpy())\n","        all_labels.extend(labels.numpy())\n","        all_paths.extend(list(paths))\n","        all_indices.extend(indices.numpy())\n","        all_probabilities.append(probabilities.cpu().numpy())\n","\n","all_preds = np.asarray(all_preds)\n","all_labels = np.asarray(all_labels)\n","all_paths = np.asarray(all_paths)\n","all_indices = np.asarray(all_indices)\n","all_probabilities = np.vstack(all_probabilities)\n","\n","cm = confusion_matrix(all_labels, all_preds)\n","report_dict = classification_report(all_labels, all_preds, output_dict=True)\n","report_text = classification_report(all_labels, all_preds)\n","\n","test_macro_auroc, test_macro_auprc = macro_auroc_auprc(all_labels, all_probabilities, num_classes)\n","test_kappa = cohen_kappa_score(all_labels, all_preds)\n","\n","np.save(f\"{results_dir}/confusion_matrix.npy\", cm)\n","pd.DataFrame(cm).to_csv(f\"{results_dir}/confusion_matrix.csv\", index=False)\n","pd.DataFrame(report_dict).transpose().to_csv(f\"{results_dir}/classification_report.csv\")\n","\n","with open(f\"{results_dir}/classification_report.txt\", \"w\") as f:\n","    f.write(report_text)\n","    f.write(f\"\\nMacro AUROC: {test_macro_auroc:.4f}\\n\")\n","    f.write(f\"Macro AUPRC: {test_macro_auprc:.4f}\\n\")\n","    f.write(f\"Cohen's Kappa: {test_kappa:.4f}\\n\")\n","\n","print(cm)\n","print(report_text)\n","print(f\"Macro AUROC: {test_macro_auroc:.4f} | Macro AUPRC: {test_macro_auprc:.4f} | \"\n","      f\"Cohen's Kappa: {test_kappa:.4f}\")\n","print(\"Saved test evaluation outputs.\")\n","\n","np.save(f\"{results_dir}/test_predictions.npy\", all_preds)\n","np.save(f\"{results_dir}/test_probabilities.npy\", all_probabilities)\n","np.save(f\"{results_dir}/test_labels.npy\", all_labels)  # needed for report metrics\n","np.save(f\"{results_dir}/test_image_paths.npy\", all_paths)\n","np.save(f\"{results_dir}/test_csv_indices.npy\", all_indices)\n","\n","# =========================================================\n","# 17. Embedding extraction (single clean block -- no duplicates,\n","#     correct 4-value unpacking, uses the Identity-head approach)\n","# =========================================================\n","embedding_model = model\n","embedding_model.heads.head = torch.nn.Identity()\n","embedding_model.eval()\n","\n","embeddings = []\n","labels_list = []\n","\n","with torch.no_grad():\n","    for images, labels, paths, indices in test_loader:\n","        images = images.to(device)\n","        feats = embedding_model(images)\n","        embeddings.append(feats.cpu().numpy())\n","        labels_list.extend(labels.numpy())\n","\n","embeddings = np.vstack(embeddings)\n","labels_list = np.array(labels_list)\n","\n","np.save(f\"{results_dir}/test_embeddings.npy\", embeddings)\n","np.save(f\"{results_dir}/test_labels.npy\", labels_list)\n","\n","print(\"Embeddings saved:\", embeddings.shape)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"-_7j6FEk7dGz","executionInfo":{"status":"ok","timestamp":1785313460716,"user_tz":-330,"elapsed":45