Max patches / slide  : 300\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 400x600 with 1 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 1800x600 with 12 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 1800x600 with 12 Axes>"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","         x         y    black%    white%       std     pink%      result\n","  ------------------------------------------------------------------------\n","     42140      1344      0.00      1.00      1.63      1.00    REJECTED\n","     71708     87808      0.00      1.00      2.56      1.00    REJECTED\n","     57820     70784      1.00      0.00      0.00      0.00    REJECTED\n","     54236      1344      1.00      0.00      0.00      0.00    REJECTED\n","     69916     69440      0.00      1.00      4.47      1.00    REJECTED\n","     72156    140224      1.00      0.00      0.00      0.00    REJECTED\n","     30044    112896      1.00      0.00      0.00      0.00    REJECTED\n","     74396     17920      0.00      1.00      2.79      0.99    REJECTED\n","     49756    109760      1.00      0.00      0.00      0.00    REJECTED\n","     73500    159040      1.00      0.00      0.00      0.00    REJECTED\n","     34524    103488      1.00      0.00      0.00      0.00    REJECTED\n","     62300     78400      0.00      0.99      5.93      0.95    REJECTED\n","     35420    133056      0.00      0.13     49.37      0.96       VALID\n","     50204     48384      1.00      0.00      0.00      0.00    REJECTED\n","     54684     44352      1.00      0.00      0.00      0.00    REJECTED\n","\n","  Slide closed.\n","  Review plots and diagnostics above.\n","  If results look good, run Blocks 14-17 for full extraction.\n"]}],"source":["# =========================\n","# Block 1 — Install dependencies\n","# =========================\n","!apt-get update -qq\n","!apt-get install -y openslide-tools\n","!pip install -q openslide-python pillow pandas scikit-learn tqdm matplotlib\n","\n","# =========================\n","# Block 2 — Imports\n","# =========================\n","import os\n","import random\n","import gc\n","import shutil\n","import multiprocessing\n","from concurrent.futures import ThreadPoolExecutor, as_completed\n","\n","import pandas as pd\n","import numpy as np\n","from PIL import Image\n","from tqdm import tqdm\n","import openslide\n","from sklearn.model_selection import train_test_split\n","import matplotlib.pyplot as plt\n","import matplotlib.patches as mpatches\n","\n","# =========================\n","# Block 3 — Mount Google Drive\n","# =========================\n","from google.colab import drive\n","drive.mount('/content/drive')\n","\n","# =========================\n","# Block 4 — Load CSV\n","# =========================\n","csv_path = \"/content/drive/MyDrive/GenResData/SynthData/labelled_slide_data.csv\"\n","\n","df = pd.read_csv(csv_path)\n","print(f\"Loaded {len(df)} slides\")\n","print(df.head())\n","print(\"\\nLabel distribution:\")\n","print(df[\"label\"].value_counts())\n","\n","# =========================\n","# Block 5 — Settings\n","# =========================\n","\n","# --- Paths ---\n","OUT_DIR = \"/content/drive/MyDrive/OralCancer_classifiers/SynthPatches\"\n","VIT_DIR = \"/content/drive/MyDrive/OralCancer_classifiers/SynthPatches_ViT\"\n","\n","# --- Magnification & patch geometry ---\n","TARGET_MAG            = 5     # back to 5x — proven to work on these slides\n","PATCH_SIZE            = 224   # pixels (ViT input size)\n","STRIDE                = 112   # 50% overlap\n","MAX_PATCHES_PER_SLIDE = 300\n","\n","# --- Tissue / background filter thresholds ---\n","BACKGROUND_THRESHOLD  = 0.65  # original value\n","TISSUE_STD_THRESHOLD  = 6     # original value\n","PINK_FRACTION_MIN     = 0.10  # original value\n","BLACK_FRACTION_MAX    = 0.05  # only new addition — rejects black canvas patches\n","\n","# --- Thumbnail size for tissue bbox detection ---\n","THUMB_SIZE            = 1024\n","\n","# --- Parallelism ---\n","NUM_WORKERS           = min(4, multiprocessing.cpu_count())\n","\n","# --- Create base output directories ---\n","os.makedirs(OUT_DIR, exist_ok=True)\n","for label in df[\"label\"].unique():\n","    os.makedirs(os.path.join(OUT_DIR, label), exist_ok=True)\n","\n","print(\"Settings ready.\")\n","print(f\"  OUT_DIR              : {OUT_DIR}\")\n","print(f\"  VIT_DIR              : {VIT_DIR}\")\n","print(f\"  TARGET_MAG           : {TARGET_MAG}x\")\n","print(f\"  PATCH_SIZE           : {PATCH_SIZE}\")\n","print(f\"  STRIDE               : {STRIDE}\")\n","print(f\"  BACKGROUND_THRESHOLD : {BACKGROUND_THRESHOLD}\")\n","print(f\"  PINK_FRACTION_MIN    : {PINK_FRACTION_MIN}\")\n","print(f\"  BLACK_FRACTION_MAX   : {BLACK_FRACTION_MAX}\")\n","print(f\"  NUM_WORKERS          : {NUM_WORKERS}\")\n","\n","# =========================\n","# Block 6 — Helper functions\n","# =========================\n","\n","def get_downsample_for_mag(slide, target_mag=5):\n","    \"\"\"\n","    Returns the downsample factor from level-0 to achieve\n","    target_mag. Assumes 40x if metadata is missing.\n","    \"\"\"\n","    obj_power = slide.properties.get(openslide.PROPERTY_NAME_OBJECTIVE_POWER)\n","    try:\n","        obj_power = float(obj_power)\n","    except (TypeError, ValueError):\n","        obj_power = 40.0\n","    return obj_power / target_mag\n","\n","\n","def is_tissue_patch(img):\n","    \"\"\"\n","    Returns True only if patch passes all four quality gates:\n","      0. Not a black / outside-canvas patch  (new)\n","      1. Not mostly white background          (original)\n","      2. Not a blank / uniform patch          (original)\n","      3. Has enough pink / eosin signal       (original)\n","    \"\"\"\n","    arr = np.array(img.convert(\"RGB\"))\n","\n","    # Gate 0 — reject black patches (outside scanner canvas)\n","    black_fraction = np.mean(\n","        (arr[:, :, 0] < 20) &\n","        (arr[:, :, 1] < 20) &\n","        (arr[:, :, 2] < 20)\n","    )\n","    if black_fraction > BLACK_FRACTION_MAX:\n","        return False\n","\n","    # Gate 1 — reject white background patches\n","    white_fraction = np.mean(\n","        (arr[:, :, 0] > 210) &\n","        (arr[:, :, 1] > 210) &\n","        (arr[:, :, 2] > 210)\n","    )\n","    if white_fraction > BACKGROUND_THRESHOLD:\n","        return False\n","\n","    # Gate 2 — reject uniform / blank patches\n","    if arr.std() < TISSUE_STD_THRESHOLD:\n","        return False\n","\n","    # Gate 3 — reject patches with insufficient pink/eosin signal\n","    pink_fraction = np.mean(\n","        (arr[:, :, 0] > 150) &\n","        (arr[:, :, 0] > arr[:, :, 1] + 15) &\n","        (arr[:, :, 0] > arr[:, :, 2] + 15)\n","    )\n","    if pink_fraction < PINK_FRACTION_MIN:\n","        return False\n","\n","    return True\n","\n","\n","def get_tissue_bboxes_level0(slide, thumb_size=THUMB_SIZE):\n","    \"\"\"\n","    Detects tissue region via pink-tissue colour mask on a thumbnail\n","    and returns bounding box scaled back to level-0 coordinates.\n","    Falls back to full slide if no tissue is detected.\n","    \"\"\"\n","    w0, h0 = slide.dimensions\n","    thumb  = slide.get_thumbnail((thumb_size, thumb_size)).convert(\"RGB\")\n","    tw, th = thumb.size\n","\n","    scale_x = w0 / tw\n","    scale_y = h0 / th\n","\n","    arr = np.array(thumb)\n","\n","    # Pink-tissue mask: R dominant, not too bright, not black\n","    tissue_mask = (\n","        (arr[:, :, 0] > 130) &\n","        (arr[:, :, 0] > arr[:, :, 1] + 10) &\n","        (arr[:, :, 0] > arr[:, :, 2] + 10) &\n","        (arr[:, :, 0] < 240)\n","    ).astype(np.uint8)\n","\n","    rows = np.any(tissue_mask, axis=1)\n","    cols = np.any(tissue_mask, axis=0)\n","\n","    if not rows.any():\n","        print(\"  [WARN] No tissue found in thumbnail — using full slide.\")\n","        return [(0, 0, w0, h0)]\n","\n","    rmin, rmax = np.where(rows)[0][[0, -1]]\n","    cmin, cmax = np.where(cols)[0][[0, -1]]\n","\n","    margin = 30\n","    rmin = max(0,  rmin - margin)\n","    rmax = min(th, rmax + margin)\n","    cmin = max(0,  cmin - margin)\n","    cmax = min(tw, cmax + margin)\n","\n","    x0 = int(cmin * scale_x)\n","    y0 = int(rmin * scale_y)\n","    x1 = int(cmax * scale_x)\n","    y1 = int(rmax * scale_y)\n","\n","    return [(x0, y0, x1, y1)]\n","\n","print(\"Helper functions defined.\")\n","\n","# =========================\n","# Block 7 — Pick slide to inspect\n","# =========================\n","\n","# Change this index to inspect a different slide\n","INSPECT_IDX = 0\n","\n","row        = df.iloc[INSPECT_IDX]\n","slide_path = row[\"path\"]\n","label      = row[\"label\"]\n","stem       = row[\"stem\"]\n","\n","print(\"=\" * 55)\n","print(f\"  Slide index : {INSPECT_IDX}\")\n","print(f\"  Stem        : {stem}\")\n","print(f\"  Label       : {label}\")\n","print(f\"  Path        : {slide_path}\")\n","print(\"=\" * 55)\n","\n","assert os.path.exists(slide_path), f\"Slide not found: {slide_path}\"\n","slide = openslide.OpenSlide(slide_path)\n","\n","w0, h0 = slide.dimensions\n","print(f\"\\n  Level-0 dimensions  : {w0} x {h0} px\")\n","print(f\"  Level count         : {slide.level_count}\")\n","print(f\"  Level dimensions    : {slide.level_dimensions}\")\n","print(f\"  Level downsamples   : {[round(d,2) for d in slide.level_downsamples]}\")\n","print(f\"  Objective power     : {slide.properties.get(openslide.PROPERTY_NAME_OBJECTIVE_POWER, 'NOT FOUND')}\")\n","\n","downsample   = get_downsample_for_mag(slide, TARGET_MAG)\n","read_size_l0 = int(PATCH_SIZE * downsample)\n","stride_l0    = int(STRIDE * downsample)\n","\n","print(f\"\\n  Target mag          : {TARGET_MAG}x\")\n","print(f\"  Downsample factor   : {downsample:.2f}\")\n","print(f\"  Read size (level-0) : {read_size_l0} x {read_size_l0} px\")\n","print(f\"  Stride (level-0)    : {stride_l0} px\")\n","\n","# =========================\n","# Block 8 — Plot 1: Full slide thumbnail\n","# =========================\n","thumb   = slide.get_thumbnail((600, 800)).convert(\"RGB\")\n","tw, th  = thumb.size\n","scale_x = w0 / tw\n","scale_y = h0 / th\n","\n","plt.figure(figsize=(4, 6))\n","plt.imshow(thumb)\n","plt.title(f\"Full slide thumbnail\\n{stem} | label: {label}\", fontsize=9)\n","plt.axis(\"off\")\n","plt.tight_layout()\n","plt.show()\n","\n","print(f\"  Thumbnail size : {tw} x {th} px\")\n","print(f\"  Scale x        : {scale_x:.2f}\")\n","print(f\"  Scale y        : {scale_y:.2f}\")\n","\n","# =========================\n","# Block 9 — Plot 2: Tissue mask\n","# =========================\n","arr_thumb = np.array(thumb)\n","\n","tissue_mask = (\n","    (arr_thumb[:, :, 0] > 130) &\n","    (arr_thumb[:, :, 0] > arr_thumb[:, :, 1] + 10) &\n","    (arr_thumb[:, :, 0] > arr_thumb[:, :, 2] + 10) &\n","    (arr_thumb[:, :, 0] < 240)\n",").astype(np.uint8)\n","\n","fig, axes = plt.subplots(1, 2, figsize=(10, 6))\n","axes[0].imshow(thumb)\n","axes[0].set_title(\"Original thumbnail\", fontsize=9)\n","axes[0].axis(\"off\")\n","\n","axes[1].imshow(tissue_mask, cmap=\"Greens\")\n","axes[1].set_title(\"Tissue mask\\n(green = detected tissue)\", fontsize=9)\n","axes[1].axis(\"off\")\n","\n","plt.suptitle(\"Tissue detection check\", fontsize=11)\n","plt.tight_layout()\n","plt.show()\n","\n","print(f\"  Tissue coverage in thumbnail : {tissue_mask.mean()*100:.1f}%\")\n","\n","# =========================\n","# Block 10 — Plot 3: Tissue bbox overlay\n","# =========================\n","bboxes                      = get_tissue_bboxes_level0(slide)\n","x0_bb, y0_bb, x1_bb, y1_bb = bboxes[0]\n","\n","print(f\"  Tissue bbox (level-0) : x0={x0_bb}, y0={y0_bb}, x1={x1_bb}, y1={y1_bb}\")\n","print(f\"  Tissue region size    : {x1_bb - x0_bb} x {y1_bb - y0_bb} px\")\n","\n","tx0 = x0_bb / scale_x\n","ty0 = y0_bb / scale_y\n","tx1 = x1_bb / scale_x\n","ty1 = y1_bb / scale_y\n","\n","fig, ax = plt.subplots(1, 1, figsize=(4, 6))\n","ax.imshow(thumb)\n","rect = mpatches.Rectangle(\n","    (tx0, ty0), tx1 - tx0, ty1 - ty0,\n","    linewidth=2, edgecolor=\"lime\", facecolor=\"none\"\n",")\n","ax.add_patch(rect)\n","ax.set_title(\"Tissue bounding box\\n(lime = patch grid area)\", fontsize=9)\n","ax.axis(\"off\")\n","plt.tight_layout()\n","plt.show()\n","\n","# =========================\n","# Block 11 — Plot 4: Patch grid overlay\n","# =========================\n","xs   = list(range(x0_bb, x1_bb - read_size_l0, stride_l0))\n","ys   = list(range(y0_bb, y1_bb - read_size_l0, stride_l0))\n","grid = [(x, y) for y in ys for x in xs]\n","\n","print(f\"  Total grid positions : {len(grid)}\")\n","print(f\"  Max patches / slide  : {MAX_PATCHES_PER_SLIDE}\")\n","\n","fig, ax = plt.subplots(1, 1, figsize=(4, 6))\n","ax.imshow(thumb)\n","\n","for (x, y) in grid:\n","    px = x / scale_x\n","    py = y / scale_y\n","    pw = read_size_l0 / scale_x\n","    ph = read_size_l0 / scale_y\n","    rect = mpatches.Rectangle(\n","        (px, py), pw, ph,\n","        linewidth=0.4, edgecolor=\"blue\",\n","        facecolor=\"none\", alpha=0.5\n","    )\n","    ax.add_patch(rect)\n","\n","ax.set_title(\n","    f\"Patch grid overlay\\n{len(grid)} positions | stride={STRIDE}px | {TARGET_MAG}x\",\n","    fontsize=9\n",")\n","ax.axis(\"off\")\n","plt.tight_layout()\n","plt.show()\n","\n","# =========================\n","# Block 12 — Plot 5: Valid vs Rejected patches\n","# =========================\n","random.shuffle(grid)\n","sample_grid = grid[:60]\n","\n","valid_patches    = []\n","rejected_patches = []\n","\n","for (x, y) in sample_grid:\n","    if len(valid_patches) >= 12 and len(rejected_patches) >= 12:\n","        break\n","    try:\n","        patch = slide.read_region(\n","            (x, y), 0, (read_size_l0, read_size_l0)\n","        ).convert(\"RGB\")\n","        patch = patch.resize((PATCH_SIZE, PATCH_SIZE), Image.BILINEAR)\n","\n","        if is_tissue_patch(patch):\n","            if len(valid_patches) < 12:\n","                valid_patches.append((patch, x, y))\n","        else:\n","            if len(rejected_patches) < 12:\n","                rejected_patches.append((patch, x, y))\n","    except Exception:\n","        continue\n","\n","# --- Valid patches ---\n","if valid_patches:\n","    fig, axes = plt.subplots(2, 6, figsize=(18, 6))\n","    axes = axes.flatten()\n","    for i, (patch, x, y) in enumerate(valid_patches):\n","        axes[i].imshow(patch)\n","        axes[i].set_title(f\"x={x}\\ny={y}\", fontsize=6)\n","        axes[i].axis(\"off\")\n","    for j in range(len(valid_patches), 12):\n","        axes[j].axis(\"off\")\n","    plt.suptitle(\n","        f\"VALID patches ({len(valid_patches)}) — {TARGET_MAG}x | {stem}\",\n","        fontsize=11, color=\"green\"\n","    )\n","    plt.tight_layout()\n","    plt.show()\n","else:\n","    print(\"[!] No VALID patches found — try lowering thresholds in Block 5\")\n","\n","# --- Rejected patches ---\n","if rejected_patches:\n","    fig, axes = plt.subplots(2, 6, figsize=(18, 6))\n","    axes = axes.flatten()\n","    for i, (patch, x, y) in enumerate(rejected_patches):\n","        axes[i].imshow(patch)\n","        axes[i].set_title(f\"x={x}\\ny={y}\", fontsize=6)\n","        axes[i].axis(\"off\")\n","    for j in range(len(rejected_patches), 12):\n","        axes[j].axis(\"off\")\n","    plt.suptitle(\n","        f\"REJECTED patches ({len(rejected_patches)}) — {TARGET_MAG}x | {stem}\",\n","        fontsize=11, color=\"red\"\n","    )\n","    plt.tight_layout()\n","    plt.show()\n","else:\n","    print(\"[!] No REJECTED patches in sample — thresholds may be too loose\")\n","\n","# =========================\n","# Block 13 — Per-patch diagnostics table\n","# =========================\n","print(f\"\\n  {'x':>8}  {'y':>8}  {'black%':>8}  {'white%':>8}  {'std':>8}  {'pink%':>8}  {'result':>10}\")\n","print(\"  \" + \"-\" * 72)\n","\n","for (x, y) in grid[:15]:\n","    try:\n","        patch = slide.read_region(\n","            (x, y), 0, (read_size_l0, read_size_l0)\n","        ).convert(\"RGB\")\n","        patch = patch.resize((PATCH_SIZE, PATCH_SIZE), Image.BILINEAR)\n","        arr   = np.array(patch)\n","\n","        black_frac = np.mean(\n","            (arr[:, :, 0] < 20) &\n","            (arr[:, :, 1] < 20) &\n","            (arr[:, :, 2] < 20)\n","        )\n","        white_frac = np.mean(\n","            (arr[:, :, 0] > 210) &\n","            (arr[:, :, 1] > 210) &\n","            (arr[:, :, 2] > 210)\n","        )\n","        std_val   = arr.std()\n","        pink_frac = np.mean(\n","            (arr[:, :, 0] > 150) &\n","            (arr[:, :, 0] > arr[:, :, 1] + 15) &\n","            (arr[:, :, 0] > arr[:, :, 2] + 15)\n","        )\n","        result = \"VALID\" if is_tissue_patch(patch) else \"REJECTED\"\n","\n","        print(\n","            f\"  {x:>8}  {y:>8}  {black_frac:>8.2f}  {white_frac:>8.2f}  \"\n","            f\"{std_val:>8.2f}  {pink_frac:>8.2f}  {result:>10}\"\n","        )\n","\n","    except Exception:\n","        print(f\"  {x:>8}  {y:>8}  {'ERROR':>55}\")\n","\n","slide.close()\n","print(\"\\n  Slide closed.\")\n","print(\"  Review plots and diagnostics above.\")\n","print(\"  If results look good, run Blocks 14-17 for full extraction.\")\n"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":8,"status":"ok","timestamp":1786425919996,"user":{"displayName":"Shirin Sitara Alok Kumar","userId":"11119974778424971100"},"user_tz":-330},"id":"lk8GzYq0Q-pr","outputId":"c108f252-498f-4808-c2d9-a606719da1a8"},"outputs":[{"name":"stdout","output_type":"stream","text":["55K\t/content/drive/MyDrive/GenResData/SynthData/ALL_FILES/N39 FNB6 Model 4.mrxs\n","\n","427M\t/content/drive/MyDrive/GenResData/SynthData/ALL_FILES/N39 FNB6 Model 4\n","\n"]}],"source":["import os\n","import subprocess\n","\n","slide_path = df.iloc[0