Copies the .mrxs file and its matching data folder\n","    from Drive to local /content/tmp_slides/.\n","    Returns the local .mrxs path.\n","    \"\"\"\n","    src_mrxs   = row[\"path\"]\n","    stem       = row[\"stem\"]\n","    src_folder = src_mrxs.replace(\".mrxs\", \"\")\n","\n","    dst_mrxs   = os.path.join(tmp_dir, os.path.basename(src_mrxs))\n","    dst_folder = dst_mrxs.replace(\".mrxs\", \"\")\n","\n","    # Copy .mrxs index file\n","    if not os.path.exists(dst_mrxs):\n","        shutil.copy2(src_mrxs, dst_mrxs)\n","\n","    # Copy data folder\n","    if not os.path.exists(dst_folder) and os.path.exists(src_folder):\n","        shutil.copytree(src_folder, dst_folder)\n","\n","    return dst_mrxs\n","\n","\n","def delete_mrxs_from_local(local_mrxs_path):\n","    \"\"\"\n","    Deletes the local .mrxs file and its data folder\n","    to free up /content disk space.\n","    \"\"\"\n","    try:\n","        os.remove(local_mrxs_path)\n","    except Exception:\n","        pass\n","    folder = local_mrxs_path.replace(\".mrxs\", \"\")\n","    if os.path.exists(folder):\n","        shutil.rmtree(folder)\n","\n","\n","def extract_patches_from_slide(row, local_slide_path):\n","    slide_records = []\n","    label         = row[\"label\"]\n","    stem          = row[\"stem\"]\n","\n","    try:\n","        slide = openslide.OpenSlide(local_slide_path)\n","    except Exception as e:\n","        print(f\"  [ERROR] Cannot open {local_slide_path}: {e}\")\n","        return slide_records\n","\n","    downsample   = get_downsample_for_mag(slide, TARGET_MAG)\n","    read_size_l0 = int(PATCH_SIZE * downsample)\n","    stride_l0    = int(STRIDE * downsample)\n","\n","    bboxes = get_tissue_bboxes_level0(slide)\n","    grid   = []\n","    for (x0, y0, x1, y1) in bboxes:\n","        xs = list(range(x0, x1 - read_size_l0, stride_l0))\n","        ys = list(range(y0, y1 - read_size_l0, stride_l0))\n","        grid += [(x, y) for y in ys for x in xs]\n","\n","    random.shuffle(grid)\n","    patch_count = 0\n","\n","    # --- First pass ---\n","    for x, y in grid:\n","        if patch_count >= MAX_PATCHES_PER_SLIDE:\n","            break\n","        try:\n","            patch = slide.read_region(\n","                (x, y), 0, (read_size_l0, read_size_l0)\n","            ).convert(\"RGB\")\n","            patch = patch.resize((PATCH_SIZE, PATCH_SIZE), Image.BILINEAR)\n","\n","            if not is_tissue_patch(patch):\n","                continue\n","\n","            patch_name = f\"{stem}_x{x}_y{y}_{TARGET_MAG}x.png\"\n","            patch_path = os.path.join(OUT_DIR, label, patch_name)\n","            patch.save(patch_path, optimize=False)\n","\n","            slide_records.append({\n","                \"patch_path\" : patch_path,\n","                \"slide_path\" : row[\"path\"],\n","                \"stem\"       : stem,\n","                \"label\"      : label,\n","                \"x_level0\"   : x,\n","                \"y_level0\"   : y,\n","                \"target_mag\" : TARGET_MAG,\n","                \"patch_size\" : PATCH_SIZE\n","            })\n","            patch_count += 1\n","\n","        except Exception:\n","            continue\n","\n","    # --- Second pass with finer stride if we need more ---\n","    if patch_count < MAX_PATCHES_PER_SLIDE:\n","        fine_stride_l0 = max(int(stride_l0 // 2), read_size_l0 // 4)\n","        fine_grid      = []\n","        for (x0, y0, x1, y1) in bboxes:\n","            xs = list(range(x0, x1 - read_size_l0, fine_stride_l0))\n","            ys = list(range(y0, y1 - read_size_l0, fine_stride_l0))\n","            fine_grid += [(x, y) for y in ys for x in xs]\n","\n","        first_pass_set = {(r[\"x_level0\"], r[\"y_level0\"]) for r in slide_records}\n","        fine_grid      = [pos for pos in fine_grid if pos not in first_pass_set]\n","        random.shuffle(fine_grid)\n","\n","        for x, y in fine_grid:\n","            if patch_count >= MAX_PATCHES_PER_SLIDE:\n","                break\n","            try:\n","                patch = slide.read_region(\n","                    (x, y), 0, (read_size_l0, read_size_l0)\n","                ).convert(\"RGB\")\n","                patch = patch.resize((PATCH_SIZE, PATCH_SIZE), Image.BILINEAR)\n","\n","                if not is_tissue_patch(patch):\n","                    continue\n","\n","                patch_name = f\"{stem}_x{x}_y{y}_{TARGET_MAG}x_f.png\"\n","                patch_path = os.path.join(OUT_DIR, label, patch_name)\n","                patch.save(patch_path, optimize=False)\n","\n","                slide_records.append({\n","                    \"patch_path\" : patch_path,\n","                    \"slide_path\" : row[\"path\"],\n","                    \"stem\"       : stem,\n","                    \"label\"      : label,\n","                    \"x_level0\"   : x,\n","                    \"y_level0\"   : y,\n","                    \"target_mag\" : TARGET_MAG,\n","                    \"patch_size\" : PATCH_SIZE\n","                })\n","                patch_count += 1\n","\n","            except Exception:\n","                continue\n","\n","    slide.close()\n","    gc.collect()\n","    return slide_records\n","\n","\n","# =========================\n","# Main extraction loop\n","# =========================\n","slides_to_process = df[~df[\"stem\"].isin(done_stems)]\n","print(f\"\\nSlides to process : {len(slides_to_process)} / {len(df)}\")\n","print(\"-\" * 55)\n","\n","for i, (_, row) in enumerate(slides_to_process.iterrows()):\n","    stem  = row[\"stem\"]\n","    label = row[\"label\"]\n","\n","    print(f\"\\n[{i+1}/{len(slides_to_process)}] {stem} | {label}\")\n","\n","    # Step 1 — copy to local disk\n","    t0 = time.time()\n","    try:\n","        local_path = copy_mrxs_to_local(row, TMP_DIR)\n","        print(f\"  Copied to local in {time.time()-t0:.1f}s → {local_path}\")\n","    except Exception as e:\n","        print(f\"  [ERROR] Copy failed: {e} — skipping\")\n","        continue\n","\n","    # Step 2 — extract patches (fast local reads)\n","    t1 = time.time()\n","    records = extract_patches_from_slide(row, local_path)\n","    print(f\"  Extracted {len(records)} patches in {time.time()-t1:.1f}s\")\n","\n","    # Step 3 — delete local copy immediately to free disk\n","    delete_mrxs_from_local(local_path)\n","    print(f\"  Local copy deleted.\")\n","\n","    # Step 4 — append to manifest and save to Drive\n","    all_records.extend(records)\n","    manifest = pd.DataFrame(all_records)\n","    manifest.to_csv(manifest_path, index=False)\n","\n","    # Step 5 — update checkpoint\n","    new_row       = pd.DataFrame([{\n","        \"stem\"      : stem,\n","        \"patches\"   : len(records),\n","        \"timestamp\" : pd.Timestamp.now().isoformat()\n","    }])\n","    checkpoint_df = pd.concat([checkpoint_df, new_row], ignore_index=True)\n","    checkpoint_df.to_csv(CHECKPOINT_PATH, index=False)\n","\n","    print(f\"  Checkpoint saved. Total patches so far: {len(all_records)}\")\n","\n","print(\"\\n\" + \"=\" * 55)\n","print(f\"Extraction complete. Total patches: {len(all_records)}\")\n","\n","# =========================\n","# Block 15 — Train / val / test split\n","# =========================\n","slide_df = df[[\"stem\", \"label\"]].drop_duplicates()\n","\n","train_slides, temp_slides = train_test_split(\n","    slide_df,\n","    test_size=0.30,\n","    stratify=slide_df[\"label\"],\n","    random_state=42\n",")\n","val_slides, test_slides = train_test_split(\n","    temp_slides,\n","    test_size=0.50,\n","    stratify=temp_slides[\"label\"],\n","    random_state=42\n",")\n","\n","train_set = set(train_slides[\"stem\"])\n","val_set   = set(val_slides[\"stem\"])\n","\n","def assign_split(stem):\n","    if stem in train_set:  return \"train\"\n","    elif stem in val_set:  return \"val\"\n","    else:                  return \"test\"\n","\n","manifest[\"split\"] = manifest[\"stem\"].apply(assign_split)\n","manifest.to_csv(\n","    os.path.join(OUT_DIR, \"patch_manifest_with_splits.csv\"),\n","    index=False\n",")\n","\n","print(\"Split distribution:\")\n","print(manifest.groupby([\"split\", \"label\"]).size().to_string())\n","\n","# =========================\n","# Block 16 — Build ViT folder structure\n","# =========================\n","for split in [\"train\", \"val\", \"test\"]:\n","    for label in manifest[\"label\"].unique():\n","        os.makedirs(os.path.join(VIT_DIR, split, label), exist_ok=True)\n","\n","copied  = 0\n","skipped = 0\n","\n","for _, row in tqdm(\n","    manifest.iterrows(),\n","    total=len(manifest),\n","    desc=\"Building ViT folders\"\n","):\n","    src = row[\"patch_path\"]\n","    dst = os.path.join(\n","        VIT_DIR,\n","        row[\"split\"],\n","        row[\"label\"],\n","        os.path.basename(src)\n","    )\n","    if not os.path.exists(src):\n","        skipped += 1\n","        continue\n","    if not os.path.exists(dst):\n","        shutil.copy2(src, dst)\n","        copied += 1\n","\n","print(f\"Done.  Copied: {copied}  |  Skipped: {skipped}\")\n","print(f\"ViT patches saved to: {VIT_DIR}\")\n","\n","# =========================\n","# Block 17 — Final summary\n","# =========================\n","print(\"=\" * 55)\n","print(\"              FINAL SUMMARY\")\n","print(\"=\" * 55)\n","print(f\"  Total patches    : {len(manifest)}\")\n","print(f\"  Target mag       : {TARGET_MAG}x\")\n","print(f\"  Patch size       : {PATCH_SIZE} x {PATCH_SIZE} px\")\n","print(f\"  Stride           : {STRIDE} px\")\n","print(f\"  Max / slide      : {MAX_PATCHES_PER_SLIDE}\")\n","print()\n","print(\"  Per-label:\")\n","for lbl, cnt in manifest[\"label\"].value_counts().items():\n","    print(f\"    {lbl:<20} {cnt}\")\n","print()\n","print(\"  Per-split:\")\n","for sp, cnt in manifest[\"split\"].value_counts().items():\n","    print(f\"    {sp:<10} {cnt}\")\n","print()\n","print(f\"  Manifest  -> {OUT_DIR}/patch_manifest_with_splits.csv\")\n","print(f\" 