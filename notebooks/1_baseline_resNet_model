l results saved to: {results_dir}\")\n","# print(\"This folder is ready to plug directly into compute_report_metrics.py's MODEL_CONFIGS list.\")"]},{"cell_type":"code","execution_count":1,"metadata":{"colab":{"background_save":true,"base_uri":"https://localhost:8080/","height":1000},"executionInfo":{"elapsed":1307088,"status":"ok","timestamp":1785490737062,"user":{"displayName":"Shirin Sitara Alok Kumar","userId":"11119974778424971100"},"user_tz":-330},"id":"flpQOTtAFmcx"},"outputs":[{"name":"stdout","output_type":"stream","text":["Drive already mounted at /content/drive; to attempt to forcibly remount, call drive.mount(\"/content/drive\", force_remount=True).\n","Device: cuda\n","Patches copied from Drive to local Colab.\n","1919 478 428\n","Number of classes: 3\n","FREEZE_MODE = 'finetuned'\n","Trainable params: 22,069,251 / 23,514,179 (93.9%)\n","Epoch 1/50\n","Train loss: 1.0689 | Train acc: 0.4508\n","Val loss:   1.0051 | Val acc:   0.5921 | Val AUROC: 0.7572 | Val AUPRC: 0.6019 | Val Kappa: 0.3675\n","Saved best model\n","Epoch 2/50\n","Train loss: 0.9922 | Train acc: 0.5623\n","Val loss:   0.9019 | Val acc:   0.6464 | Val AUROC: 0.8010 | Val AUPRC: 0.6286 | Val Kappa: 0.4607\n","Saved best model\n","Epoch 3/50\n","Train loss: 0.9232 | Train acc: 0.6128\n","Val loss:   0.8753 | Val acc:   0.6423 | Val AUROC: 0.8077 | Val AUPRC: 0.6398 | Val Kappa: 0.4605\n","Epoch 4/50\n","Train loss: 0.8606 | Train acc: 0.6597\n","Val loss:   0.8687 | Val acc:   0.6339 | Val AUROC: 0.8103 | Val AUPRC: 0.6410 | Val Kappa: 0.4507\n","Epoch 5/50\n","Train loss: 0.8373 | Train acc: 0.6649\n","Val loss:   0.8548 | Val acc:   0.6569 | Val AUROC: 0.8171 | Val AUPRC: 0.6505 | Val Kappa: 0.4853\n","Saved best model\n","Epoch 6/50\n","Train loss: 0.7943 | Train acc: 0.6998\n","Val loss:   0.8715 | Val acc:   0.6402 | Val AUROC: 0.8147 | Val AUPRC: 0.6535 | Val Kappa: 0.4597\n","No val_loss improvement for 1 epoch(s).\n","Epoch 7/50\n","Train loss: 0.7714 | Train acc: 0.7311\n","Val loss:   0.8780 | Val acc:   0.6485 | Val AUROC: 0.8108 | Val AUPRC: 0.6536 | Val Kappa: 0.4730\n","No val_loss improvement for 2 epoch(s).\n","Epoch 8/50\n","Train loss: 0.7328 | Train acc: 0.7457\n","Val loss:   0.8999 | Val acc:   0.6234 | Val AUROC: 0.8044 | Val AUPRC: 0.6548 | Val Kappa: 0.4376\n","No val_loss improvement for 3 epoch(s).\n","Epoch 9/50\n","Train loss: 0.7212 | Train acc: 0.7504\n","Val loss:   0.9041 | Val acc:   0.6527 | Val AUROC: 0.8111 | Val AUPRC: 0.6613 | Val Kappa: 0.4792\n","No val_loss improvement for 4 epoch(s).\n","Epoch 10/50\n","Train loss: 0.7006 | Train acc: 0.7686\n","Val loss:   0.9347 | Val acc:   0.6820 | Val AUROC: 0.8109 | Val AUPRC: 0.6669 | Val Kappa: 0.5219\n","Saved best model\n","No val_loss improvement for 5 epoch(s).\n","Early stopping triggered after epoch 10 (no val_loss improvement for 5 epochs).\n","Saved training history.\n"]},{"data":{"image/png":"\n","text/plain":["\u003cFigure size 800x500 with 1 Axes\u003e"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["\u003cFigure size 800x500 with 1 Axes\u003e"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["\u003cFigure size 800x500 with 1 Axes\u003e"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["[[ 77  18   1]\n"," [ 34 143  38]\n"," [  8  48  61]]\n","              precision    recall  f1-score   support\n","\n","           0       0.65      0.80      0.72        96\n","           1       0.68      0.67      0.67       215\n","           2       0.61      0.52      0.56       117\n","\n","    accuracy                           0.66       428\n","   macro avg       0.65      0.66      0.65       428\n","weighted avg       0.66      0.66      0.65       428\n","\n","Macro AUROC: 0.7941 | Macro AUPRC: 0.6641 | Cohen's Kappa: 0.4535\n","Saved test evaluation outputs.\n","\n","All results saved to: /content/drive/MyDrive/GenResData/ResNet50_finetuned_results\n","This folder is ready to plug directly into compute_report_metrics.py's MODEL_CONFIGS list.\n"]}],"source":["# =========================================================\n","# ResNet-50 training/eval script\n","# Mirrors train_vit_clean.py's structure and metrics so the two\n","# architectures can be fairly compared in the same report table.\n","# =========================================================\n","\n","# =========================================================\n","# 1. Mount Google Drive\n","# =========================================================\n","from google.colab import drive\n","drive.mount('/content/drive')\n","\n","# =========================================================\n","# 2. Imports\n","# =========================================================\n","import os\n","import shutil\n","from pathlib import Path\n","\n","import numpy as np\n","import pandas as pd\n","import torch\n","import torch.nn as nn\n","from torch.utils.data import Dataset, DataLoader\n","from torchvision import transforms\n","from torchvision.models import resnet50, ResNet50_Weights\n","from PIL import Image\n","from sklearn.metrics import (\n","    classification_report,\n","    confusion_matrix,\n","    roc_auc_score,\n","    average_precision_score,\n","    cohen_kappa_score,\n",")\n","from sklearn.preprocessing import label_binarize\n","import matplotlib.pyplot as plt\n","import torch.nn.functional as F\n","\n","# =========================================================\n","# 3. Device\n","# =========================================================\n","device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n","print(\"Device:\", device)\n","\n","# =========================================================\n","# 4. Copy patches from Drive to local Colab disk\n","#    (skip if you already ran the ViT script this session --\n","#    the folder will already exist locally)\n","# =========================================================\n","drive_patch_root = \"/content/drive/MyDrive/GenResData/Patches\"\n","local_patch_root = \"/content/patches\"\n","\n","shutil.copytree(drive_patch_root, local_patch_root, dirs_exist_ok=True)\n","print(\"Patches copied from Drive to local Colab.\")\n","\n","# =========================================================\n","# 5. CSV paths\n","# =========================================================\n","train_csv = \"/content/drive/MyDrive/GenResData/train_patch_df.csv\"\n","val_csv   = \"/content/drive/MyDrive/GenResData/val_patch_df.csv\"\n","clean_test_csv = \"/content/drive/MyDrive/GenResData/test_patch_df_clean.csv\"\n","# (assumes the ViT script already produced the cleaned test CSV;\n","#  if not, rerun that cleaning step from train_vit_clean.py first)\n","\n","# =========================================================\n","# 6. Dataset class (identical to the ViT script's version)\n","# =========================================================\n","class OralPatchDataset(Dataset):\n","    def __init__(self, csv_file, transform=None):\n","        self.df = pd.read_csv(csv_file).reset_index(drop=True)\n","        self.transform = transform\n","\n","    def __len__(self):\n","        return len(self.df)\n","\n","    def __getitem__(self, idx):\n","        row = self.df.iloc[idx]\n","        img_path = str(row[\"patch_path\"])\n","        label = int(row[\"label\"])\n","\n","        image = Image.open(img_path).convert(\"RGB\")\n","        if self.transform is not None:\n","            image = self.transform(image)\n","\n","        return image, label, img_path, idx\n","\n","# =========================================================\n","# 7. Transforms\n","#    Same augmentation strategy as the ViT script's Exp 4 config,\n","#    so the comparison isn't confounded by different preprocessing.\n","# =========================================================\n","train_tfms = transforms.Compose([\n","    transforms.Resize((256, 256)),\n","    transforms.RandomResizedCrop(224, scale=(0.75, 1.0)),\n","    transforms.RandomHorizontalFlip(),\n","    transforms.RandomVerticalFlip(),\n","    transforms.RandomRotation(20),\n","    transforms.ColorJitter(brightness=0.2, contrast=0.2, saturation=0.2, hue=0.02),\n","    transforms.ToTensor(),\n","    transforms.Normalize(mean=[0.485, 0.456, 0.406],\n","                         std=[0.229, 0.224, 0.225]),\n","    transforms.RandomErasing(p=0.25, scale=(0.02, 0.1)),\n","])\n","\n","eval_tfms = transforms.Compose([\n","    transforms.Resize((224, 224)),\n","    transforms.ToTensor(),\n","    transforms.Normalize(mean=[0.485, 0.456, 0.406],\n","                         std=[0.229, 0.224, 0.225])\n","])\n","\n","# =========================================================\n","# 8. Datasets \u0026 Dataloaders\n","# =========================================================\n","train_ds = OralPatchDataset(train_csv, transform=train_tfms)\n","val_ds   = OralPatchDataset(val_csv, transform=eval_tfms)\n","test_ds  = OralPatchDataset(clean_test_csv, transform=eval_tfms)\n","\n","train_loader = DataLoader(train_ds, batch_size=16, shuffle=True, num_workers=2)\n","val_loader   = DataLoader(val_ds, batch_size=16, shuffle=False, num_workers=2)\n","test_loader  = DataLoader(test_ds, batch_size=16, shuffle=False, num_workers=2)\n","\n","print(len(train_ds), len(val_ds), len(test_ds))\n","\n","num_classes = len(sorted(pd.read_csv(train_csv)[\"label\"].unique()))\n","print(\"Number of classes:\", num_classes)\n","\n","# =========================================================\n","# 9. Model + freezing mode\n","#\n","# FREEZE_MODE controls how much of ResNet-50 gets to keep learning:\n","#   \"frozen\"    -\u003e whole backbone locked (conv1..layer4), only the\n","#                  new head is trainable (\"linear probe\" -- the\n","#                  classic before-fine-tuning baseline)\n","#   \"finetuned\" -\u003e unlock layer4 (ResNet's last residual block) +\n","#                  the head, keep everything earlier frozen\n","#                  (mirrors the ViT script's partial-freeze idea)\n","#\n","# Run this script once with each setting to get both rows of the\n","# \"before vs after fine-tuning\" comparison table.\n","# =========================================================\n","FREEZE_MODE = \"finetuned\"   # change to \"finetuned\" for the second run\n","assert FREEZE_MODE in (\"frozen\", \"finetuned\")\n","\n","weights = ResNet50_Weights.DEFAULT\n","model = resnet50(weights=weights)\n","\n","in_features = model.fc.in_features\n","DROPOUT_P = 0.3\n","model.fc = nn.Sequential(\n","    nn.Dropout(p=DROPOUT_P),\n","    nn.Linear(in_features, num_classes),\n",")\n","model = model.to(device)\n","\n","# Step 1: freeze everything by default\n","for param in model.parameters():\n","    param.requires_grad = False\n","\n","# Step 2: selectively unfreeze depending on FREEZE_MODE\n","if FREEZE_MODE == \"finetuned\":\n","    for param in model.layer3.parameters():\n","        param.requires_grad = True\n","    for param in model.layer4.parameters():\n","        param.requires_grad = True\n","\n","# The head is always trainable -- it's new and untrained\n","for param in model.fc.parameters():\n","    param.requires_grad = True\n","\n","trainable_params = sum(p.numel() for p in model.parameters() if p.requires_grad)\n","total_params = sum(p.numel() for p in model.parameters())\n","print(f\"FREEZE_MODE = '{FREEZE_MODE}'\")\n","print(f\"Trainable params: {trainable_params:,} / {total_params:,} \"\n","      f\"({100 * trainable_params / total_params:.1f}%)\")\n","\n","# =========================================================\n","# 10. Loss \u0026 optimizer\n","# =========================================================\n","LABEL_SMOOTHING = 0.1\n","\n","# With weighted loss:\n","class_counts = pd.read_csv(train_csv)[\"label\"].value_counts().sort_index()\n","class_weights = 1.0 / class_counts\n","class_weights = class_weights / class_weights.sum() * len(class_weights)\n","class_weights = torch.tensor(class_weights, dtype=torch.float32).to(device)\n","\n","criterion = nn.CrossEntropyLoss(weight=class_weights, label_smoothing=LABEL_SMOOTHING)\n","\n","optimizer = torch.optim.AdamW(\n","    filter(lambda p: p.requires_grad, model.parameters()),\n","    lr=3e-5,\n","    weight_decay=1e-4,\n",")\n","\n","# =========================================================\n","# 11. Train / eval loops (identical logic to the ViT script)\n","# =========================================================\n","def train_one_epoch(model, loader):\n","    model.train()\n","    running_loss = 0.0\n","    correct = 0\n","    total = 0\n","\n","    for images, labels, paths, indices in loader:\n","        images = images.to(device)\n","        labels = labels.to(device)\n","\n","        optimizer.zero_grad()\n","        outputs = model(images)\n","        loss = criterion(outputs, labels)\n","        loss.backward()\n","        optimizer.step()\n","\n","        running_loss += loss.item() * images.size(0)\n","        preds = outputs.argmax(dim=1)\n","        correct += (preds == labels).sum().item()\n","        total += labels.size(0)\n","\n","    return running_loss / total, correct / total\n","\n","\n","@torch.no_grad()\n","def evaluate(model, loader, return_probs=False):\n","    model.eval()\n","    running_loss = 0.0\n","    correct = 0\n","    total = 0\n","\n","    all_labels_ = []\n","    all_probs_ = []\n","\n","    for images, labels, paths, indices in loader:\n","        images = images.to(device)\n","        labels = labels.to(device)\n","\n","        outputs = model(images)\n","        loss = criterion(outputs, labels)\n","\n","        running_loss += loss.item() * images.size(0)\n","        probs = torch.softmax(outputs, dim=1)\n","        preds = probs.argmax(dim=1)\n","        correct += (preds == labels).sum().item()\n","        total += labels.size(0)\n","\n","        if return_probs:\n","            all_labels_.extend(labels.cpu().numpy())\n","            all_probs_.append(probs.cpu().numpy())\n","\n","    avg_loss = running_loss / total\n","    avg_acc = correct / total\n","\n","    if return_probs:\n","        return avg_loss, avg_acc, np.array(all_labels_), np.vstack(all_probs_)\n","    return avg_loss, avg_acc\n","\n","\n","def macro_auroc_auprc(y_true, y_prob, n_classes):\n","    y_bin = label_binarize(y_true, classes=list(range(n_classes)))\n","    aurocs, auprcs = [], []\n","    for c in range(n_classes):\n","        if y_bin[:, c].sum() == 0 or y_bin[:, c].sum() == len(y_bin):\n","            continue\n","        aurocs.append(roc_auc_score(y_bin[:, c], y_prob[:, c]))\n","        auprcs.append(average_precision_score(y_bin[:, c], y_prob[:, c]))\n","    return float(np.mean(aurocs)), float(np.mean(auprcs))\n","\n","# =========================================================\n","# 12. Training (with early stopping + per-epoch AUROC/AUPRC/kappa)\n","# =========================================================\n","results_dir = f\"/content/drive/MyDrive/GenResData/ResNet50_{FREEZE_MODE}_results\"\n","os.makedirs(results_dir, exist_ok=True)\n","\n","history = {\n","    \"epoch\": [], \"train_loss\": [], \"train_acc\": [],\n","    \"val_loss\": [], \"val_acc\": [],\n","    \"val_macro_auroc\": [], \"val_macro_auprc\": [], \"val_kappa\": [],\n","}\n","\n","best_val_acc = 0\n","num_epochs = 50\n","PATIENCE = 5\n","best_val_loss = float(\"inf\")\n","epochs_no_improve = 0\n","\n","for epoch in range(num_epochs):\n","    train_loss, train_acc = train_one_epoch(model, train_loader)\n","    val_loss, val_acc, val_labels, val_probs = evaluate(model, val_loader, return_probs=True)\n","\n","    val_preds = val_probs.argmax(axis=1)\n","    val_macro_auroc, val_macro_auprc = macro_auroc_auprc(val_labels, val_probs, num_classes)\n","    val_kappa = cohen_kappa_score(val_labels, val_preds)\n","\n","    history[\"epoch\"].append(epoch + 1)\n","    history[\"train_loss\"].append(train_loss)\n","    history[\"train_acc\"].append(train_acc)\n","    history[\"val_loss\"].append(val_loss)\n","    history[\"val_acc\"].append(val_acc)\n","    history[\"val_macro_auroc\"].append(val_macro_auroc)\n","    history[\"val_macro_auprc\"].append(val_macro_auprc)\n","    history[\"val_kappa\"].append(val_kappa)\n","\n","    print(f\"Epoch {epoch+1}/{num_epochs}\")\n","    print(f\"Train loss: {train_loss:.4f} | Train acc: {train_acc:.4f}\")\n","    print(f\"Val loss:   {val_loss:.4f} | Val acc:   {val_acc:.4f} | \"\n","          f\"Val AUROC: {val_macro_auroc:.4f} | Val AUPRC: {val_macro_auprc:.4f} | \"\n","          f\"Val Kappa: {val_kappa:.4f}\")\n","\n","    if val_acc \u003e best_val_acc:\n","        best_val_acc = val_acc\n","        torch.save(model.state_dict(), f\"{results_dir}/best_resnet50_oral_dysplasia.pth\")\n","        print(\"Saved best model\")\n","\n","    if val_loss \u003c best_val_loss - 1e-4:\n","        best_val_loss = val_loss\n","        epochs_no_improve = 0\n","    else:\n","        epochs_no_improve += 1\n","        print(f\"No val_loss improvement for {epochs_no_improve} epoch(s).\")\n","        if epochs_no_improve \u003e= PATIENCE:\n","            print(f\"Early stopping triggered after epoch {epoch + 1} \"\n","                  f\"(no val_loss improvement for {PATIENCE} epochs).\")\n","            break\n","\n","history_df = pd.DataFrame(history)\n","history_df.to_csv(f\"{results_dir}/training_history.csv\", index=False)\n","print(\"Saved training history.\")\n","\n","# =========================================================\n","# 13. Plots\n","# =========================================================\n","plt.figure(figsize=(8, 5))\n","plt.plot(history_df[\"epoch\"], history_df[\"train_loss\"], marker=\"o\", label=\"Train Loss\")\n","plt.plot(history_df[\"epoch\"], history_df[\"val_loss\"], marker=\"o\", label=\"Val Loss\")\n","plt.xlabel(\"Epoch\"); plt.ylabel(\"Loss\")\n","plt.title(f\"ResNet-50 ({FREEZE_MODE}) Training and Validation Loss\")\n","plt.legend(); plt.grid(True)\n","plt.savefig(f\"{results_dir}/loss_curve.png\", dpi=300, bbox_inches=\"tight\")\n","plt.show()\n","\n","plt.figure(figsize=(8, 5))\n","plt.plot(history_df[\"epoch\"], history_df[\"train_acc\"], marker=\"o\", label=\"Train Accuracy\")\n","plt.plot(history_df[\"epoch\"], history_df[\"val_acc\"], marker=\"o\", label=\"Val Accuracy\")\n","plt.xlabel(\"Epoch\"); plt.ylabel(\"Accuracy\")\n","plt.title(f\"ResNet-50 ({FREEZE_MODE}) Training and Validation Accuracy\")\n","plt.legend(); plt.grid(True)\n","plt.savefig(f\"{results_dir}/accuracy_curve.png\", dpi=300, bbox_inches=\"tight\")\n","plt.show()\n","\n","plt.figure(figsize=(8, 5))\n","plt.plot(history_df[\"epoch\"], history_df[\"val_macro_auroc\"], marker=\"o\", label=\"Val Macro AUROC\")\n","plt.plot(history_df[\"epoch\"], history_df[\"val_macro_auprc\"], marker=\"o\", label=\"Val Macro AUPRC\")\n","plt.plot(history_df[\"epoch\"], history_df[\"val_kappa\"], marker=\"o\", label=\"Val Cohen's Kappa\")\n","plt.xlabel(\"Epoch\"); plt.ylabel(\"Score\")\n","plt.title(f\"ResNet-50 ({FREEZE_MODE}) Validation AUROC / AUPRC / Kappa\")\n","plt.legend(); plt.grid(True)\n","plt.savefig(f\"{results_dir}/val_ranking_metrics_curve.png\", dpi=300, bbox_inches=\"tight\")\n","plt.show()\n","\n","# =========================================================\n","# 14. Test evaluation\n","# =========================================================\n","model.load_state_dict(\n","    torch.load(f\"{results_dir}/best_resnet50_oral_dysplasia.pth\", map_location=device)\n",")\n","model.eval()\n","\n","all_preds, all_labels, all_paths, all_indices, all_probabilities = [], [], [], [], []\n","\n","with torch.no_grad():\n","    for images, labels, paths, indices in test_loader:\n","        images = images.to(device)\n","        outputs = model(images)\n","        probabilities = torch.softmax(outputs, dim=1)\n","        preds = outputs.argmax(dim=1)\n","\n","        all_preds.extend(preds.cpu().numpy())\n","        all_labels.extend(labels.numpy())\n","        all_paths.extend(list(paths))\n","        all_indices.extend(indices.numpy())\n","        all_probabilities.append(probabilities.cpu().numpy())\n","\n","all_preds = np.asarray(all_preds)\n","all_labels = np.asarray(all_labels)\n","all_paths = np.asarray(all_paths)\n","all_indices = np.asarray(all_indices)\n","all_probabilities = np.vstack(all_probabilities)\n","\n","cm = confusion_matrix(all_labels, all_preds)\n","report_dict = classification_report(all_labels, all_preds, output_dict=True)\n","report_text = classification_report(all_labels, all_preds)\n","\n","test_macro_auroc, test_macro_auprc = macro_auroc_auprc(all_labels, all_probabilities, num_classes)\n","test_kappa = cohen_kappa_score(all_labels, all_preds)\n","\n","np.save(f\"{results_dir}/confusion_matrix.npy\", cm)\n","pd.DataFrame(cm).to_csv(f\"{results_dir}/confusion_matrix.csv\", index=False)\n","pd.DataFrame(report_dict).transpose().to_csv(f\"{results_dir}/classification_report.csv\")\n","\n","with open(f\"{results_dir}/classification_report.txt\", \"w\") as f:\n","    f.write(report_text)\n","    f.write(f\"\\nMacro AUROC: {test_macro_auroc:.4f}\\n\")\n","    f.write(f\"Macro AUPRC: {test_macro_auprc:.4f}\\n\")\n","    f.write(f\"Cohen's Kappa: {test_kappa:.4f}\\n\")\n","\n","print(cm)\n","print(report_text)\n","print(f\"Macro AUROC: {test_macro_auroc:.4f} | Macro AUPRC: {test_macro_auprc:.4f} | \"\n","      f\"Cohen's Kappa: {test_kappa:.4f}\")\n","print(\"Saved test evaluation outputs.\")\n","\n","np.save(f\"{results_dir}/test_predictions.npy\", all_preds)\n","np.save(f\"{results_dir}/test_probabilities.npy\", all_probabilities)\n","np.save(f\"{results_dir}/test_labels.npy\", all_labels)\n","np.save(f\"{results_dir}/test_image_paths.npy\", all_paths)\n","np.save(f\"{results_dir}/test_csv_indices.npy\", all_indices)\n","\n","print(f\"\\nAll results saved to: {results_dir}\")\n","print(\"This folder is ready to plug directly into compute_report_metrics.py's MODEL_CONFIGS list.\")"]}],"m