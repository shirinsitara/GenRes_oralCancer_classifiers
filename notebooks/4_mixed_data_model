─ Copy & Unzip Synth Patches ─────────────────────────────────────────────────\n","import shutil, subprocess\n","\n","print(\"Copying zip to local...\")\n","shutil.copy(\n","    \"/content/drive/MyDrive/OralCancer_classifiers/SynthPatches.zip\",\n","    \"/content/SynthPatches.zip\"\n",")\n","print(\"Done!\")\n","\n","print(\"Unzipping...\")\n","subprocess.run([\n","    \"unzip\", \"-q\",\n","    \"/content/SynthPatches.zip\",\n","    \"-d\", \"/content/synth_patches\"\n","], check=True)\n","print(\"Done!\")\n","\n","# ── Verify Counts ──────────────────────────────────────────────────────────────\n","base = \"/content/synth_patches/SynthPatches\"\n","classes = [\"cancer\", \"dysplasia\", \"healthy\"]\n","\n","for cls in classes:\n","    count = len(os.listdir(os.path.join(base, cls)))\n","    print(f\"  {cls}: {count} patches\")\n","\n","# ── Load & Fix Manifest ────────────────────────────────────────────────────────\n","manifest = pd.read_csv(f\"{base}/patch_manifest_with_splits.csv\")\n","\n","def fix_path(old_path):\n","    parts = old_path.split(\"/\")\n","    label    = parts[-2]\n","    filename = parts[-1]\n","    return os.path.join(base, label, filename)\n","\n","manifest[\"patch_path\"] = manifest[\"patch_path\"].apply(fix_path)\n","\n","print(\"\\nSplit distribution:\")\n","print(manifest[\"split\"].value_counts())\n","print(\"\\nClass distribution per split:\")\n","print(manifest.groupby([\"split\", \"label\"]).size().unstack())\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Dosx8U46zIBk","executionInfo":{"status":"ok","timestamp":1786687097387,"user_tz":-330,"elapsed":50646,"user":{"displayName":"Shirin Sitara","userId":"00335778139770320874"}},"outputId":"bd6e272b-ec46-41c2-add3-0a7dbf60a0ef"},"execution_count":6,"outputs":[{"output_type":"stream","name":"stdout","text":["Copying zip to local...\n","Done!\n","Unzipping...\n","Done!\n","  cancer: 3000 patches\n","  dysplasia: 11100 patches\n","  healthy: 4200 patches\n","\n","Split distribution:\n","split\n","train    12600\n","test      3000\n","val       2700\n","Name: count, dtype: int64\n","\n","Class distribution per split:\n","label  cancer  dysplasia  healthy\n","split                            \n","test      600       1800      600\n","train    2100       7500     3000\n","val       300       1800      600\n"]}]},{"cell_type":"code","source":["# ── Mixed Dataset ──────────────────────────────────────────────────────────────\n","import torch\n","from torch.utils.data import Dataset, DataLoader, WeightedRandomSampler\n","from torchvision import transforms\n","from PIL import Image\n","\n","BATCH_SIZE = 32\n","\n","train_transforms = transforms.Compose([\n","    transforms.Resize((224, 224)),\n","    transforms.RandomHorizontalFlip(),\n","    transforms.RandomVerticalFlip(),\n","    transforms.RandomRotation(15),\n","    transforms.ColorJitter(brightness=0.2, contrast=0.2, saturation=0.2),\n","    transforms.ToTensor(),\n","    transforms.Normalize([0.485, 0.456, 0.406],\n","                         [0.229, 0.224, 0.225])\n","])\n","\n","val_test_transforms = transforms.Compose([\n","    transforms.Resize((224, 224)),\n","    transforms.ToTensor(),\n","    transforms.Normalize([0.485, 0.456, 0.406],\n","                         [0.229, 0.224, 0.225])\n","])\n","\n","class MixedPatchDataset(Dataset):\n","    def __init__(self, df, transform=None):\n","        self.df = df.reset_index(drop=True)\n","        self.transform = transform\n","\n","    def __len__(self):\n","        return len(self.df)\n","\n","    def __getitem__(self, idx):\n","        row = self.df.iloc[idx]\n","        image = Image.open(row[\"patch_path\"]).convert(\"RGB\")\n","        label = int(row[\"label\"])\n","        if self.transform:\n","            image = self.transform(image)\n","        return image, label\n","\n","# ── Build Mixed Train DataFrame ────────────────────────────────────────────────\n","# Synth train split\n","synth_train = manifest[manifest[\"split\"] == \"train\"][[\"patch_path\", \"label\"]].copy()\n","synth_train[\"label\"] = synth_train[\"label\"].map({\"cancer\": 0, \"dysplasia\": 1, \"healthy\": 2})\n","synth_train[\"source\"] = \"synth\"\n","\n","# Real train patches\n","real_train = train_patch_df[[\"patch_path\", \"label\"]].copy()\n","real_train[\"source\"] = \"real\"\n","\n","# Combine\n","mixed_train_df = pd.concat([synth_train, real_train], ignore_index=True)\n","\n","print(\"Mixed train composition:\")\n","print(mixed_train_df[\"source\"].value_counts())\n","print(\"\\nClass distribution:\")\n","print(mixed_train_df[\"label\"].value_counts())\n","\n","# ── WeightedRandomSampler ──────────────────────────────────────────────────────\n","# Weight by BOTH class AND source (real patches get boosted)\n","source_weight_map = {\"synth\": 1.0, \"real\": 6.0}  # real upsampled 6x\n","class_counts = mixed_train_df[\"label\"].value_counts().to_dict()\n","\n","sample_weights = []\n","for _, row in mixed_train_df.iterrows():\n","    class_w  = 1.0 / class_counts[row[\"label\"]]\n","    source_w = source_weight_map[row[\"source\"]]\n","    sample_weights.append(class_w * source_w)\n","\n","sample_weights = torch.tensor(sample_weights, dtype=torch.float)\n","\n","sampler = WeightedRandomSampler(\n","    weights=sample_weights,\n","    num_samples=len(sample_weights),\n","    replacement=True\n",")\n","\n","# ── Dataloaders ────────────────────────────────────────────────────────────────\n","# Train: mixed synth + real\n","train_dataset = MixedPatchDataset(mixed_train_df, transform=train_transforms)\n","\n","# Val & Test: REAL ONLY (we want to measure real-world performance)\n","val_dataset  = MixedPatchDataset(val_patch_df[[\"patch_path\", \"label\"]], transform=val_test_transforms)\n","test_dataset = MixedPatchDataset(test_patch_df[[\"patch_path\", \"label\"]], transform=val_test_transforms)\n","\n","train_loader = DataLoader(train_dataset, batch_size=BATCH_SIZE, sampler=sampler, num_workers=2)\n","val_loader   = DataLoader(val_dataset,   batch_size=BATCH_SIZE, shuffle=False,   num_workers=2)\n","test_loader  = DataLoader(test_dataset,  batch_size=BATCH_SIZE, shuffle=False,   num_workers=2)\n","\n","print(f\"\\nTrain: {len(train_dataset)} | Val: {len(val_dataset)} | Test: {len(test_dataset)}\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"lL4KE4iX2OEh","executionInfo":{"status":"ok","timestamp":1786687518436,"user_tz":-330,"elapsed":748,"user":{"displayName":"Shirin Sitara","userId":"00335778139770320874"}},"outputId":"31cdf1c9-0775-4e0f-d2b2-e3f1dcbeae81"},"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["Mixed train composition:\n","source\n","synth    12600\n","real      1919\n","Name: count, dtype: int64\n","\n","Class distribution:\n","label\n","1    8202\n","2    3419\n","0    2898\n","Name: count, dtype: int64\n","\n","Train: 14519 | Val: 478 | Test: 428\n"]}]},{"cell_type":"code","source":["# ── Copy Real Patches from Drive to Local ─────────────────────────────────────\n","import shutil, os\n","\n","drive_patch_root = \"/content/drive/MyDrive/GenResData/Patches\"\n","local_patch_root = \"/content/patches\"\n","\n","for split in [\"train\", \"val\", \"test\"]:\n","    src = os.path.join(drive_patch_root, split)\n","    dst = os.path.join(local_patch_root, split)\n","\n","    print(f\"Copying {split}...\")\n","    shutil.copytree(src, dst, dirs_exist_ok=True)\n","    print(f\"  ✅ {len(os.listdir(dst))} files in {dst}\")\n","\n","print(\"\\nAll real patches copied locally!\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"aSDIAZku4fY0","executionInfo":{"status":"ok","timestamp":1786687733760,"user_tz":-330,"elapsed":80864,"user":{"displayName":"Shirin Sitara","userId":"00335778139770320874"}},"outputId":"44de6908-f923-4e05-b6bf-fb75e19c41e8"},"execution_count":9,"outputs":[{"output_type":"stream","name":"stdout","text":["Copying train...\n","  ✅ 1920 files in /content/patches/train\n","Copying val...\n","  ✅ 478 files in /content/patches/val\n","Copying test...\n","  ✅ 428 files in /content/patches/test\n","\n","All real patches copied locally!\n"]}]},{"cell_type":"code","source":["# ── Verify Patch Paths ─────────────────────────────────────────────────────────\n","missing = 0\n","for path in train_patch_df[\"patch_path\"].values[:20]:\n","    if not os.path.exists(path):\n","        print(f\"Missing: {path}\")\n","        missing += 1\n","\n","if missing == 0:\n","    print(\"✅ All spot-checked paths exist — ready to train!\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"67ErQchg4zoH","executionInfo":{"status":"ok","timestamp":1786687736336,"user_tz":-330,"elapsed":7,"user":{"displayName":"Shirin Sitara","userId":"00335778139770320874"}},"outputId":"08f18d33-c20a-4774-a667-38b9563688f1"},"execution_count":10,"outputs":[{"output_type":"stream","name":"stdout","text":["✅ All spot-checked paths exist — ready to train!\n"]}]},{"cell_type":"code","source":["# ── Fine-tuning Loop ───────────────────────────────────────────────────────────\n","import copy\n","from sklearn.metrics import balanced_accuracy_score, classification_report, confusion_matrix\n","import seaborn as sns\n","import matplotlib.pyplot as plt\n","\n","NUM_EPOCHS   = 40\n","LR           = 1e-4\n","PATIENCE     = 7\n","CLASS_NAMES  = [\"OSCC\", \"Leukoplakia w/ dysplasia\", \"Leukoplakia w/o dysplasia\"]\n","SAVE_PATH    = \"/content/drive/MyDrive/GenResData/mixed_finetuned_resnet50.pth\"\n","\n","# ── Freeze backbone, train head first for 5 epochs ────────────────────────────\n","for name, param in model.named_parameters():\n","    if \"fc\" not in name:\n","        param.requires_grad = False\n","\n","optimizer = torch.optim.AdamW(\n","    filter(lambda p: p.requires_grad, model.parameters()),\n","    lr=LR, weight_decay=1e-4\n",")\n","criterion = nn.CrossEntropyLoss()\n","\n","print(\"Phase 1: Training head only (5 epochs)...\")\n","\n","for epoch in range(5):\n","    model.train()\n","    running_loss, correct, total = 0.0, 0, 0\n","\n","    for images, labels in train_loader:\n","        images, labels = images.to(DEVICE), labels.to(DEVICE)\n","        optimizer.zero_grad()\n","        outputs = model(images)\n","        loss = criterion(outputs, labels)\n","        loss.backward()\n","        optimizer.step()\n","\n","        running_loss += loss.item() * images.size(0)\n","        correct += (outputs.argmax(1) == labels).sum().item()\n","        total += labels.size(0)\n","\n","    print(f\"  Epoch {epoch+1}/5 | Loss: {running_loss/total:.4f} | Acc: {correct/total:.4f}\")\n","\n","# ── Unfreeze all layers for full fine-tuning ───────────────────────────────────\n","for param in model.parameters():\n","    param.requires_grad = True\n","\n","optimizer = torch.optim.AdamW(\n","    model.parameters(), lr=1e-5, weight_decay=1e-4  # lower LR for full fine-tune\n",")\n","scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(\n","    optimizer, T_max=NUM_EPOCHS\n",")\n","\n","print(\"\\nPhase 2: Full fine-tuning...\")\n","\n","best_val_bal_acc    = 0.0\n","best_model_weights  = copy.deepcopy(model.state_dict())\n","patience_counter    = 0\n","history             = []\n","\n","for epoch in range(NUM_EPOCHS):\n","    # --- Train ---\n","    model.train()\n","    running_loss, correct, total = 0.0, 0, 0\n","\n","    for images, labels in train_loader:\n","        images, labels = images.to(DEVICE), labels.to(DEVICE)\n","        optimizer.zero_grad()\n","        outputs = model(images)\n","        loss = criterion(outputs, labels)\n","        loss.backward()\n","        optimizer.step()\n","\n","        running_loss += loss.item() * images.size(0)\n","        correct += (outputs.argmax(1) == labels).sum().item()\n","        total += labels.size(0)\n","\n","    train_loss = running_loss / total\n","    train_acc  = correct / total\n","\n","    # --- Validate ---\n","    model.eval()\n","    val_loss, val_correct, val_total = 0.0, 0, 0\n","    all_labels, all_preds = [], []\n","\n","    with torch.no_grad():\n","        for images, labels in val_loader:\n","            images, labels = images.to(DEVICE), labels.to(DEVICE)\n","            outputs = model(images)\n","            loss = criterion(outputs, labels)\n","\n","            val_loss    += loss.item() * images.size(0)\n","            val_correct += (outputs.argmax(1) == labels).sum().item()\n","            val_total   += labels.size(0)\n","\n","            all_preds.extend(outputs.argmax(1).cpu().numpy())\n","            all_labels.extend(labels.cpu().numpy())\n","\n","    val_loss    = val_loss / val_total\n","    val_acc     = val_correct / val_total\n","    val_bal_acc = balanced_accuracy_score(all_labels, all_preds)\n","\n","    scheduler.step()\n","\n","    history.append({\n","        \"epoch\":        epoch + 1,\n","        \"train_loss\":   train_loss,\n","        \"train_acc\":    train_acc,\n","        \"val_loss\":     val_loss,\n","        \"val_acc\":      val_acc,\n","        \"val_bal_acc\":  val_bal_acc\n","    })\n","\n","    print(\n","        f\"Epoch {epoch+1:02d}/{NUM_EPOCHS} | \"\n","        f\"Train Loss: {train_loss:.4f} | Train Acc: {train_acc:.4f} | \"\n","        f\"Val Loss: {val_loss:.4f} | Val Acc: {val_acc:.4f} | \"\n","        f\"Val Bal Acc: {val_bal_acc:.4f}\"\n","    )\n","\n","    if val_bal_acc > best_val_bal_acc:\n","        best_val_bal_acc   = val_bal_acc\n","        best_model_weights = copy.deepcopy(model.state_dict())\n","        patience_counter   = 0\n","        print(\"  ✅ Best model saved\")\n","    else:\n","        patience_counter += 1\n","\n","    if patience_counter >= PATIENCE:\n","        print(\"  ⏹ Early stopping triggered\")\n","        break\n","\n","model.load_state_dict(best_model_weights)\n","torch.save(best_model_weights, SAVE_PATH)\n","print(f\"\\nBest Val Balanced Acc: {best_val_bal_acc:.4f}\")\n","\n","# ── Test Evaluation ────────────────────────────────────────────